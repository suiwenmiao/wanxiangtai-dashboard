# Copy this file to .env on each computer and edit the local paths.
# Keep .env private. Do not commit real paths, cookies, reports, or Excel files.

# Excel sheet name inside WORKBUDDY_DATA_FILE.
WORKBUDDY_SHEET_NAME=3月

# Windows example:
# WORKBUDDY_DATA_FILE=D:\your-folder\万相台数据表.xlsx
# WORKBUDDY_BASE_TABLE=C:\Users\your-name\Desktop\商品ID基础表最新.23.xlsx
# WORKBUDDY_REPORT_DIR=D:\your-folder\wanxiangtai_reports
# WORKBUDDY_ALIMAMA_STATE=C:\Users\your-name\.workbuddy\alimama_state.json

# macOS example:
# WORKBUDDY_DATA_FILE=/Users/your-name/Documents/wanxiangtai/万相台数据表.xlsx
# WORKBUDDY_BASE_TABLE=/Users/your-name/Desktop/商品ID基础表最新.23.xlsx
# WORKBUDDY_REPORT_DIR=/Users/your-name/Documents/wanxiangtai/reports
# WORKBUDDY_ALIMAMA_STATE=/Users/your-name/.workbuddy/alimama_state.json

# Optional automation settings.
# WORKBUDDY_REPORT_DATE=2026-07-14
# WORKBUDDY_DOWNLOAD_TIMEOUT=1200
# WORKBUDDY_DEPLOY_TIMEOUT=600
# WORKBUDDY_DOWNLOAD_ATTEMPTS=6
# WORKBUDDY_DOWNLOAD_RETRY_DELAY=1800
